# Copy to .env at the repository root and fill in. Values here are only
# defaults: anything already exported in the shell wins, and every model role
# can also be overridden per-run on the command line.

# --- Execution model (runs the generated harness's agent loop) -------------
# Any OpenAI-compatible chat-completions endpoint.
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=

# Model id used as `model:` in every benchmark config. Override per run with
# --exec-model.
EXEC_MODEL=deepseek-v4-flash

# --- Judge model (grades the produced artifacts) ---------------------------
# Defaults to the execution endpoint when JUDGE_API_* are unset.
JUDGE_MODEL=deepseek-v4-flash
# JUDGE_API_BASE=
# JUDGE_API_KEY=

# --- Meta model (writes the harness) --------------------------------------
# Used by the JIT pipeline only. The CLI flags --meta-model / --meta-base /
# --meta-key take precedence over these.
META_MODEL=jit
META_API_BASE=http://localhost:8000/v1
META_API_KEY=EMPTY
# Local model dir or HF repo id, for `--selector logprob`. Leave empty and
# selection falls back to the judge strategy, which needs no tokenizer.
META_TOKENIZER=

# --- Tool credentials ------------------------------------------------------
# web_search (xbench, deepsearchqa, agentif). NOTE: a spent key does not
# error out -- web_search returns "not enough credits", the judge scores the
# resulting empty answers as wrong, and the run reads as a model regression.
SERPER_API_KEY=
# crawl_page, same benchmarks.
JINA_API_KEY=

# --- OdysseyBench retrieval (only with memory_mode: use_rag) ---------------
# EMBED_API_BASE=
# EMBED_MODEL=qwen/qwen3-embedding-8b
