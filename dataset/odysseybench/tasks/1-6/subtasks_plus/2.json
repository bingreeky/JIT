    "evaluation": [
        {
            "function": "evaluate_excel_cell_value",
            "args": {
                "file": "./data/class_member.xlsx",
                "matches": [
                    {
                        "row": "1",
                        "col": "2",
                        "value": "Meeting"
                    }
                ]
            }
        },
        {
            "function": "evaluate_excel_cell_comparator",
            "args": {
                "file": "./data/class_member.xlsx",
                "matches": [
                    {
                        "row": "2",
                        "col": "2",
                        "comparator": "lambda x: '8:00' in x"
                    },
                    {
                        "row": "3",
                        "col": "2",
                        "comparator": "lambda x: '8:10' in x"
                    },
                    {
                        "row": "4",
                        "col": "2",
                        "comparator": "lambda x: '8:20' in x"
                    },
                    {
                        "row": "5",
                        "col": "2",
                        "comparator": "lambda x: '8:30' in x"
                    },
                    {
                        "row": "6",
                        "col": "2",
                        "comparator": "lambda x: '8:40' in x"
                    }
                ]
            }
        }
    ],
    "query_sentence": "Assign and record meeting times for Class 1 students in the excel file."
